# Sub2API all-in-one deployment defaults
SUB2API_IMAGE=ghcr.io/sjz960913/sub2api-allinone:latest
BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
COLLABORATION_ENABLED=false
TZ=Asia/Shanghai

# Admin account. Leave ADMIN_PASSWORD empty to auto-generate and persist it in data/allinone.env.
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

# PostgreSQL. Leave POSTGRES_PASSWORD empty to auto-generate and persist it in data/allinone.env.
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=
POSTGRES_MAX_CONNECTIONS=1024

# Redis. Leave REDIS_PASSWORD empty for local-container-only Redis without auth.
REDIS_PASSWORD=
REDIS_DB=0

# Secrets. Leave empty to auto-generate and persist them in data/allinone.env.
JWT_SECRET=
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=

# Internal service ports inside the container.
DATABASE_PORT=5432
REDIS_PORT=6379
