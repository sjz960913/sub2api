# =============================================================================
# Sub2API all-in-one image
# =============================================================================
# Builds frontend/backend, then runs Sub2API, PostgreSQL, and Redis in one
# container. This is intended for single-host private deployments.
# =============================================================================

ARG NODE_IMAGE=node:24-bookworm
ARG GOLANG_IMAGE=golang:1.27.0-bookworm
ARG GOPROXY=https://goproxy.cn,direct
ARG GOSUMDB=sum.golang.google.cn

# -----------------------------------------------------------------------------
# Stage 1: Frontend builder
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS frontend-builder

WORKDIR /app/frontend

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ ./
COPY docs/legal/ /app/docs/legal/
RUN pnpm run build

# -----------------------------------------------------------------------------
# Stage 2: Backend builder
# -----------------------------------------------------------------------------
FROM ${GOLANG_IMAGE} AS backend-builder

ARG VERSION=
ARG COMMIT=docker-allinone
ARG DATE
ARG GOPROXY
ARG GOSUMDB

ENV GOPROXY=${GOPROXY}
ENV GOSUMDB=${GOSUMDB}

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      tzdata && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./
COPY --from=frontend-builder /app/backend/internal/web/dist ./internal/web/dist

RUN VERSION_VALUE="${VERSION}" && \
    if [ -z "${VERSION_VALUE}" ]; then VERSION_VALUE="$(./scripts/resolve-version.sh)"; fi && \
    DATE_VALUE="${DATE:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" && \
    CGO_ENABLED=0 GOOS=linux go build \
      -tags embed \
      -ldflags="-s -w -X main.Version=${VERSION_VALUE} -X main.Commit=${COMMIT} -X main.Date=${DATE_VALUE} -X main.BuildType=release" \
      -trimpath \
      -o /app/sub2api \
      ./cmd/server

# -----------------------------------------------------------------------------
# Stage 3: Runtime with Go, Node.js, PostgreSQL, Redis, and Sub2API
# -----------------------------------------------------------------------------
FROM ${GOLANG_IMAGE}

LABEL maintainer="sjz960913"
LABEL description="Sub2API all-in-one runtime with Go, Node.js, PostgreSQL, and Redis"
LABEL org.opencontainers.image.source="https://github.com/sjz960913/sub2api"

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      gosu \
      nodejs \
      npm \
      openssl \
      postgresql \
      postgresql-client \
      procps \
      redis-server \
      tini \
      tzdata && \
    rm -rf /var/lib/apt/lists/*

RUN useradd --system --create-home --home-dir /app --shell /usr/sbin/nologin sub2api && \
    mkdir -p /app/data /app/resources /var/lib/postgresql/data /var/lib/redis /run/postgresql && \
    chown -R sub2api:sub2api /app && \
    chown -R postgres:postgres /var/lib/postgresql /run/postgresql && \
    chown -R redis:redis /var/lib/redis

WORKDIR /app

COPY --from=backend-builder --chown=sub2api:sub2api /app/sub2api /app/sub2api
COPY --from=backend-builder --chown=sub2api:sub2api /app/backend/resources /app/resources
COPY deploy/allinone-entrypoint.sh /app/allinone-entrypoint.sh

RUN chmod +x /app/allinone-entrypoint.sh

ENV DATA_DIR=/app/data \
    AUTO_SETUP=true \
    SERVER_HOST=0.0.0.0 \
    SERVER_PORT=8080 \
    DATABASE_HOST=127.0.0.1 \
    DATABASE_PORT=5432 \
    DATABASE_DBNAME=sub2api \
    DATABASE_SSLMODE=disable \
    REDIS_HOST=127.0.0.1 \
    REDIS_PORT=6379 \
    REDIS_DB=0 \
    REDIS_ENABLE_TLS=false \
    TZ=Asia/Shanghai

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:${SERVER_PORT:-8080}/health" >/dev/null || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/app/allinone-entrypoint.sh"]
